# Docker environment configuration
# Copy this to .env for Docker-based development

# Database
DB_USER=hyrox_user
DB_PASSWORD=hyrox_password
DB_NAME=hyrox_db
DB_PORT=5432

# PostgreSQL Connection String
DATABASE_URL="postgresql://hyrox_user:hyrox_password@postgres:5432/hyrox_db"

# Next.js
NODE_ENV=production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_PORT=3000

# pgAdmin (optional - only used with debug profile)
PGADMIN_EMAIL=admin@hyrox.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
